# Copy to .env.qa (gitignored). Do not use these values in production.

POSTGRES_USER=hyperlocalmart
POSTGRES_PASSWORD=change-me-qa-pg
REDIS_PASSWORD=change-me-qa-redis
JWT_SECRET=change-me-qa-jwt-must-be-at-least-32-chars!!

# Empty = anyone can register (QA). Comma-separated phones to lock invite.
BUYER_INVITE_PHONES=

# QA testers can use 111111. Leave empty in production.
DELIVERY_OTP_FIXED_CODE=111111
PASSWORD_RESET_OTP_FIXED_CODE=111111

# Razorpay Test keys. Leave blank to keep COD-only / stub payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CHECKOUT_NAME=KoyaKart

# Razorpay Test Mode only. Leave blank to keep stub payments.
# Never paste Key Secret in chat. Do not use Live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
