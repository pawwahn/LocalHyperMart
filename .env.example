# Copy to .env.local (gitignored). Used by scripts/start-dev.ps1.

# Razorpay Test keys from Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Secret (required for live webhook capture)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CHECKOUT_NAME=KoyaKart

# Cashfree test keys: https://merchant.cashfree.com/merchants/pg/developers/api-keys
# Sandbox base is the default. Set the production URL only with live keys.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_BASE_URL=https://sandbox.cashfree.com/pg

# PhonePe test keys from the PhonePe business dashboard. Use production only with live keys.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
PAYMENT_RETURN_URL=http://localhost:5175/shop
