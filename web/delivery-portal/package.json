{
  "name": "hyperlocalmart-delivery-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hub": "tsc -b && vite build --mode hub",
    "build:agent": "tsc -b && vite build --mode agent",
    "preview": "vite preview",
    "android:sync:hub": "node scripts/use-capacitor-hub-config.mjs && npm run build:hub && npx cap sync android",
    "android:sync:agent": "npm run build:agent && node scripts/use-capacitor-agent-config.mjs && npx cap sync android",
    "android:open:hub": "npx cap open android",
    "android:open:agent": "node scripts/use-capacitor-agent-config.mjs && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "maplibre-gl": "^6.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
